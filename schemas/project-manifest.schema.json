{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-earth.local/schemas/project-manifest.schema.json",
  "title": "NEOS Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "name",
    "repository"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "concept",
        "experimental",
        "active",
        "maintenance",
        "archived"
      ]
    },
    "repository": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "default_branch": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}